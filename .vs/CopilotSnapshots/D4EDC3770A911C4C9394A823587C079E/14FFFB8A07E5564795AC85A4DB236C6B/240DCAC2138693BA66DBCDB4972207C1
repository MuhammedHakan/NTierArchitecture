namespace NTierArchitecture.Domain.Entities;

public abstract class BaseEntity
{
    public int ID { get; set; }
    public DateTime CreateDate { get; set; }
    public DateTime UpdateDate { get; set; }
    public bool IsActive { get; set; }
}
public class Student : BaseEntity
{
    public string? Name { get; set; }
    public int ClassID { get; set; }
    public bool Gender { get; set; }
    public DateTime DateOfBirth { get; set; }
    public string? Phone { get; set; }

    public Class? Class { get; set; }

    public ICollection<Discontinuity>? Discontinuties { get; set; }
    public ICollection<Exam>? Exams { get; set; }

}
public class Teacher : BaseEntity
{
    public string? Name { get; set; }
    public string? Branch { get; set; }
    public string? Phone { get; set; }

    public Lesson? LessonID { get; set; }
}
public class Class : BaseEntity
{
    public string? Name { get; set; }
    public int Capacity { get; set; }

    public Lesson? LessonID { get; set; }

    public ICollection<Lesson> Lessons { get; set; }
    public ICollection<Student>? Students { get; set; }
}
public class Lesson : BaseEntity
{
    public string? Name { get; set; }
    public int TeacherID { get; set; }
    public int WeeklyHour { get; set; }

    public Exam? ExamID { get; set; }

    public ICollection<Exam>? Lessons { get; set; }
    public ICollection<Teacher>? Teachers { get; set; }
}
public class Exam : BaseEntity
{
    public int LessonID { get; set; }
    public int StudentID { get; set; }
    public DateTime ExamDate { get; set; }
    public int Duration { get; set; }
    public float Note1 { get; set; }
    public float Note2 { get; set; }
    public Student? Student { get; set; }

    public Lesson? LessonID { get; set; }
}
public class Discontinuity : BaseEntity
{
    public int StudentID { get; set; }
    public DateTime DateofDiscontinuity { get; set; }
    public int Days { get; set; }
    public bool Excuse { get; set; }

    public Student? Student { get; set; }
}